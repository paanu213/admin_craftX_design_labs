# ─── Copy this file to .env and fill in real values ──────────────────────────
# Never commit .env — it is gitignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase direct connection (@ in password must be encoded as %40)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Local development
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Production (set in Netlify environment variables dashboard)
# AUTH_URL="https://your-site.netlify.app"
# NEXTAUTH_URL="https://your-site.netlify.app"

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="craftx-receipts"
# Public URL for the R2 bucket (custom domain or r2.dev URL)
R2_PUBLIC_URL="https://receipts.yourdomain.com"
