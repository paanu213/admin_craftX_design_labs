# ─── Copy this file to .env and fill in real values ──────────────────────────
# Never commit .env — it is gitignored.

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection pooler — used by the app at runtime (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection — used by Prisma Migrate (port 5432)
# (@ in password must be encoded as %40)
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Local development
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Production (set in Netlify environment variables dashboard)
# AUTH_URL="https://your-site.netlify.app"
# NEXTAUTH_URL="https://your-site.netlify.app"

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="craftx-receipts"
# Public URL for the R2 bucket (custom domain or r2.dev URL)
R2_PUBLIC_URL="https://receipts.yourdomain.com"

# ─── Optional: One-time admin initializer ────────────────────────────────────
# Set this to any random string, deploy, then POST to /api/setup/init-admin?token=VALUE
# This creates admin@craftxlabs.com / Admin@123 with full access.
# REMOVE this var immediately after creating the account.
# SETUP_TOKEN="your-random-one-time-token"

# Get these from the Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
# Webhook secret — set in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
# Optional: callback URL after payment (e.g. your domain's thank-you page)
RAZORPAY_CALLBACK_URL=""
