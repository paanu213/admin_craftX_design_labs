generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  CEO
  CMO
  CFO
  CTO
  COO
}

enum ClientStatus {
  REGISTERED
  KEY_GENERATED
  ACTIVE
  INACTIVE
  TRIAL
  CHURNED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ExpenseCategory {
  SAAS
  PAYROLL
  MARKETING
  OPERATIONS
  INFRASTRUCTURE
  TRAVEL
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KeyStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AppCategory {
  BILLING
  INVENTORY
  POS
  RESTAURANT
  HOSPITAL
  SCHOOL
  REAL_ESTATE
  LOGISTICS
  CRM
  HR_PAYROLL
  FINANCE
  MANUFACTURING
  E_COMMERCE
  OTHER
}

enum AppStatus {
  ACTIVE
  BETA
  MAINTENANCE
  DEPRECATED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CEO)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expensesCreated     Expense[]       @relation("ExpenseCreatedBy")
  expensesApproved    Expense[]       @relation("ExpenseApprovedBy")
  keysGenerated       ActivationKey[] @relation("KeyGeneratedBy")
  expenseApprovals    ExpenseApproval[] @relation("ExpenseApprovals")
  applicationsCreated Application[]   @relation("AppCreatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// Client
// ─────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  phone           String?
  company         String
  industry        String?
  website         String?
  businessType    String?
  gstNumber       String?
  panNumber       String?
  address         String?
  city            String?
  country         String?
  pincode         String?
  state           String?
  locality        String?
  addressLine1    String?
  addressLine2    String?
  appRequirements String[]     @default([])
  status          ClientStatus @default(TRIAL)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contacts      Contact[]
  subscription  Subscription?
  activationKey ActivationKey?

  @@map("clients")
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Subscription {
  id           String       @id @default(cuid())
  clientId     String       @unique
  planName     String
  price        Decimal      @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  renewalDate  DateTime?
  isAutoRenew   Boolean      @default(true)
  features      String[]
  applicationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])

  @@map("subscriptions")
}

model ActivationKey {
  id            String    @id @default(cuid())
  clientId      String    @unique
  key           String    @unique
  status        KeyStatus @default(PENDING)
  generatedById String
  generatedAt   DateTime  @default(now())
  activatedAt   DateTime?

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  generatedBy User   @relation("KeyGeneratedBy", fields: [generatedById], references: [id])

  @@map("activation_keys")
}

// ─────────────────────────────────────────────
// Expense
// ─────────────────────────────────────────────

model Expense {
  id            String          @id @default(cuid())
  title         String
  description   String?
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("INR")
  category      ExpenseCategory
  expenseDate   DateTime
  receiptUrl    String?
  status        ExpenseStatus   @default(PENDING)
  rejectionNote String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  createdBy  User  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvals  ExpenseApproval[]

  @@map("expenses")
}

model ExpenseApproval {
  id         String                @id @default(cuid())
  expenseId  String
  approverId String
  status     ExpenseApprovalStatus @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime              @default(now())

  expense  Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver User    @relation("ExpenseApprovals", fields: [approverId], references: [id])

  @@unique([expenseId, approverId])
  @@map("expense_approvals")
}

// ─────────────────────────────────────────────
// Application
// ─────────────────────────────────────────────

model Application {
  id            String      @id @default(cuid())
  name          String
  description   String?
  category      AppCategory
  version       String
  status        AppStatus   @default(ACTIVE)
  logoUrl       String?
  monthlyPrice  Decimal?    @db.Decimal(10, 2)
  yearlyPrice   Decimal?    @db.Decimal(10, 2)
  currency      String      @default("INR")
  website       String?
  playStoreUrl  String?
  appStoreUrl   String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  createdBy     User          @relation("AppCreatedBy", fields: [createdById], references: [id])
  subscriptions Subscription[]

  @@map("applications")
}
