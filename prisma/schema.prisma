generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CEO
  CMO
  CFO
  CTO
  COO
  EMPLOYEE
  CUSTOMER_CARE
}

enum ClientStatus {
  REGISTERED
  KEY_GENERATED
  ACTIVE
  INACTIVE
  TRIAL
  CHURNED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ExpenseCategory {
  SAAS
  PAYROLL
  MARKETING
  OPERATIONS
  INFRASTRUCTURE
  TRAVEL
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KeyStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum KeyType {
  TRIAL
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

enum PaymentReceiver {
  EMPLOYEE
  COMPANY
}

enum PaymentStatus {
  PENDING_DEPOSIT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AppStatus {
  ACTIVE
  BETA
  MAINTENANCE
  DEPRECATED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model UserGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     UserGroupMember[]

  @@map("user_groups")
}

model UserGroupMember {
  userId    String
  groupId   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_group_members")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(EMPLOYEE)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships      UserGroupMember[]
  expensesCreated       Expense[]           @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]           @relation("ExpenseApprovedBy")
  keysGenerated         ActivationKey[]     @relation("KeyGeneratedBy")
  expenseApprovals      ExpenseApproval[]   @relation("ExpenseApprovals")
  applicationsCreated   Application[]       @relation("AppCreatedBy")
  paymentsRecorded      Payment[]           @relation("PaymentRecordedBy")
  paymentsApproved      Payment[]           @relation("PaymentApprovedBy")
  paymentsCancelled     Payment[]           @relation("PaymentCancelledBy")
  devPasswordsGenerated DevAccessPassword[]  @relation("DevPasswordGeneratedBy")
  systemConfigsUpdated  SystemConfig[]       @relation("ConfigUpdatedBy")
  razorpayLinksCreated  RazorpayPaymentLink[] @relation("RazorpayLinkCreatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// Client
// ─────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  clientCode      String?      @unique @map("client_code")
  name            String
  email           String       @unique
  phone           String?
  company         String
  industry        String?
  website         String?
  businessType    String?
  gstNumber       String?
  panNumber       String?
  address         String?
  city            String?
  country         String?
  pincode         String?
  state           String?
  locality        String?
  addressLine1    String?
  addressLine2    String?
  appRequirements String[]     @default([])
  status          ClientStatus @default(TRIAL)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contacts            Contact[]
  subscription        Subscription?
  activationKey       ActivationKey?
  payments            Payment[]
  devAccessPasswords  DevAccessPassword[]
  razorpayLinks       RazorpayPaymentLink[]

  @@map("clients")
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Subscription {
  id           String       @id @default(cuid())
  clientId     String       @unique
  planName     String
  price        Decimal      @db.Decimal(10, 2)
  currency     String       @default("INR")
  billingCycle BillingCycle @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  renewalDate  DateTime?
  isAutoRenew   Boolean      @default(true)
  features      String[]
  applicationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application   Application?          @relation(fields: [applicationId], references: [id])
  payments      Payment[]
  razorpayLinks RazorpayPaymentLink[]

  @@map("subscriptions")
}

model ActivationKey {
  id            String    @id @default(cuid())
  clientId      String    @unique
  key           String    @unique
  status        KeyStatus @default(PENDING)
  keyType       KeyType   @default(SUBSCRIPTION)
  generatedById String
  generatedAt   DateTime  @default(now())
  activatedAt   DateTime?
  expiresAt     DateTime?

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  generatedBy User   @relation("KeyGeneratedBy", fields: [generatedById], references: [id])

  @@map("activation_keys")
}

// ─────────────────────────────────────────────
// Expense
// ─────────────────────────────────────────────

model Expense {
  id            String          @id @default(cuid())
  title         String
  description   String?
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("INR")
  category      ExpenseCategory
  expenseDate   DateTime
  receiptUrl    String?
  status        ExpenseStatus   @default(PENDING)
  rejectionNote String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  createdBy  User  @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvals  ExpenseApproval[]

  @@map("expenses")
}

model ExpenseApproval {
  id         String                @id @default(cuid())
  expenseId  String
  approverId String
  status     ExpenseApprovalStatus @default(PENDING)
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime              @default(now())

  expense  Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  approver User    @relation("ExpenseApprovals", fields: [approverId], references: [id])

  @@unique([expenseId, approverId])
  @@map("expense_approvals")
}

// ─────────────────────────────────────────────
// Application
// ─────────────────────────────────────────────

model Application {
  id            String      @id @default(cuid())
  name          String
  description   String?
  category      String
  version       String
  status        AppStatus   @default(ACTIVE)
  logoUrl       String?
  monthlyPrice  Decimal?    @db.Decimal(10, 2)
  yearlyPrice   Decimal?    @db.Decimal(10, 2)
  currency      String      @default("INR")
  website       String?
  playStoreUrl  String?
  appStoreUrl   String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  createdBy     User          @relation("AppCreatedBy", fields: [createdById], references: [id])
  subscriptions Subscription[]

  @@map("applications")
}

// ─────────────────────────────────────────────
// Payment
// ─────────────────────────────────────────────

model Payment {
  id             String          @id @default(cuid())
  clientId       String
  subscriptionId String?
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  method         PaymentMethod
  receivedBy     PaymentReceiver
  paymentDate    DateTime
  note           String?
  status         PaymentStatus   @default(PENDING_DEPOSIT)
  isRenewal      Boolean         @default(false)
  recordedById   String
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  cancelledAt    DateTime?       @map("cancelled_at")
  cancelledById  String?         @map("cancelled_by_id")
  cancellationNote String?       @map("cancellation_note")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  approvedBy   User?         @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  cancelledBy  User?         @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────
// Dev Access
// ─────────────────────────────────────────────

model DevAccessPassword {
  id            String    @id @default(cuid())
  clientId      String
  generatedById String
  passwordHash  String
  password      String?
  reason        String
  expiresAt     DateTime
  usedAt        DateTime?
  usedFromIp    String?
  createdAt     DateTime  @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  generatedBy User   @relation("DevPasswordGeneratedBy", fields: [generatedById], references: [id])

  @@map("dev_access_passwords")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("system_config")
}

// ─────────────────────────────────────────────
// Master Data
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// Razorpay
// ─────────────────────────────────────────────

model RazorpayPaymentLink {
  id             String    @id @default(cuid())
  clientId       String    @map("client_id")
  subscriptionId String?   @map("subscription_id")
  razorpayLinkId String    @unique @map("razorpay_link_id")
  url            String
  shortUrl       String?   @map("short_url")
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("INR")
  description    String?
  status         String    @default("created")
  expiresAt      DateTime? @map("expires_at")
  paidAt         DateTime? @map("paid_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("RazorpayLinkCreatedBy", fields: [createdById], references: [id])

  @@map("razorpay_payment_links")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  websiteUrl  String?   @map("website_url")
  launchDate  DateTime? @map("launch_date")
  apiUrl      String?   @map("api_url")
  apiKey      String?   @map("api_key")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("products")
}

model AppCategoryMaster {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_category_master")
}
